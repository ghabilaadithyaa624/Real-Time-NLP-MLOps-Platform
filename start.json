{
  "daemon": true,
  "run": [
    {
      "method": "shell.run",
      "params": {
        "venv": "env",
        "env": {
          "GRADIO_SERVER_PORT": "7860",
          "GRADIO_SERVER_NAME": "127.0.0.1"
        },
        "message": "python app.py",
        "on": [
          {
            "event": "/http:\\/\\/127\\.0\\.0\\.1:7860[0-9a-zA-Z_\\-\\.\\/]*/",
            "done": true
          },
          {
            "event": "/http:\\/\\/\\S+:7860/",
            "done": true
          }
        ]
      }
    },
    {
      "method": "local.set",
      "params": {
        "url": "{{input.event ? input.event[0] : 'http://127.0.0.1:7860'}}"
      }
    },
    {
      "method": "browser.open",
      "params": {
        "uri": "http://127.0.0.1:7860",
        "target": "_blank"
      }
    }
  ]
}
