{
  "run": [
    {
      "method": "shell.run",
      "params": {
        "venv": "env",
        "message": [
          "python -m pip install --upgrade pip",
          "pip install -r requirements.txt"
        ]
      }
    },
    {
      "method": "notify",
      "params": {
        "html": "Installation complete! Click <b>Start</b> to launch the application."
      }
    }
  ]
}
